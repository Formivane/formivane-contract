# Formivane Intelligence Centre - optional settings. Copy to .env (never commit .env).
# No API keys are required: Find a Tender and Contracts Finder OCDS APIs are public and keyless,
# and AI work runs through Claude Code on your subscription login (no Anthropic API key).

# Override database location (default data/fic.db)
# FIC_DB=data/fic.db
# Alternative config/profile files
# FIC_CONFIG=config/fic.toml
# FIC_PROFILE=config/company_profile.toml
